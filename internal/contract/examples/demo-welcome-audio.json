{
  "run_id": "demo-welcome-audio",
  "work": {
    "id": { "system": "demo", "change_id": "welcome-audio" },
    "system": "demo"
  },
  "requires": [
    { "as": "voice", "capability": "agent.reason", "harness": "claude", "service": "tts", "tts_typecast": "yes" },
    { "as": "board", "capability": "agent.reason", "board": "rpi2b-v1.1", "audio_playback": "true", "os": "darwin" }
  ],
  "steps": [
    {
      "id": "synthesize",
      "uses": "voice",
      "agent": { "max_turns": 5, "ask": "never" },
      "in": { "prompt": "Use the existing bin/tts-typecast.sh script in this workspace to synthesize Korean audio saying exactly \"{{submitter}}님 환영합니다\". Pass that text as its first argument and $OUT/welcome.wav as its second argument. Verify the command succeeds and the output file is nonempty. Do not change the script or use another speech provider." },
      "out": ["welcome.wav"]
    },
    {
      "id": "play",
      "uses": "board",
      "needs": ["synthesize"],
      "in": { "from": ["welcome.wav"] },
      "run": ["sh", "-c", "enode-demo-play \"$IN/welcome.wav\" && echo ok > \"$OUT/played.txt\""],
      "out": ["played.txt"]
    }
  ],
  "success_when": [
    { "step": "synthesize", "produced": ["welcome.wav"] },
    { "step": "play", "exit_code": 0, "produced": ["played.txt"] }
  ]
}
