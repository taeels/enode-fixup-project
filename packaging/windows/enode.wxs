<?xml version="1.0" encoding="utf-8"?>
<!--
  윈도우 설치본(MSI).

  ★ 리눅스에서 굽는다 ★ — msitools 의 wixl 을 쓴다. 윈도우 러너를 안 쓰는
  이유는 ADR-015 가 Go 를 고른 이유와 같다: 짓는 곳과 도는 곳을 가르면
  CI 가 단순해진다. ★ 다만 확인은 윈도우에서 한다 ★ — 굽는 것과 깔리는 것은
  다른 문제이고, msiexec 이 실제로 받아주는지는 윈도우만 답할 수 있다.

  ★ wixl 이 못 하는 것 하나 ★ — <Environment> 를 지원하지 않는다(실측:
  "unhandled child Component node Environment"). 그래서 ★ PATH 를 안 건드린다 ★.
  설치 경로는 C:\Program Files\enode 이고 사람이 PATH 에 넣거나 전체 경로로 부른다.
  ★ 되돌리는 조건 ★ — 윈도우 노드를 실제로 세워 보고 PATH 가 없어서 불편하면
  그때 WiX 정식 툴체인(windows 러너)으로 옮기거나 설치 후 스크립트를 붙인다.

  버전과 파일 경로는 wixl -D 로 들어온다 — packaging/build-installers.sh 를 보라.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="enode" Language="1033" Version="$(var.Version)"
           Manufacturer="taeels" UpgradeCode="6f3b1a2c-9d4e-4f7a-8b21-5c0d9e7a4b13">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine"
             Description="enode — 실행 노드와 그 도구들" />
    <MajorUpgrade DowngradeErrorMessage="이미 더 새 버전이 설치돼 있습니다." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="enode">
          <Component Id="C_enode" Guid="1a2b3c4d-1111-4a5b-9c8d-000000000001" Win64="yes">
            <File Id="F_enode" Source="$(var.BinDir)/enode.exe" KeyPath="yes" />
          </Component>
          <Component Id="C_runctl" Guid="1a2b3c4d-2222-4a5b-9c8d-000000000002" Win64="yes">
            <File Id="F_runctl" Source="$(var.BinDir)/runctl.exe" KeyPath="yes" />
          </Component>
          <Component Id="C_enodectl" Guid="1a2b3c4d-3333-4a5b-9c8d-000000000003" Win64="yes">
            <File Id="F_enodectl" Source="$(var.BinDir)/enodectl.exe" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Main" Title="enode" Level="1">
      <ComponentRef Id="C_enode" />
      <ComponentRef Id="C_runctl" />
      <ComponentRef Id="C_enodectl" />
    </Feature>
  </Product>
</Wix>
