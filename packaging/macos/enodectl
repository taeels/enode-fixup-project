#!/usr/bin/env bash
# enodectl — 맥에서 enode ★ 인스턴스들 ★ 을 다룬다.
#
#   enodectl list                설정 = 노드. 무엇이 있고 무엇이 도는가
#   enodectl id <이름>           node_id 를 미리 계산한다 (띄우기 전에 확인)
#   enodectl start <이름>
#   enodectl stop  <이름>
#   enodectl logs  <이름> [-f]
#   enodectl status
#
# ★ 왜 「이름」이 인자인가 ★
# 설정 파일이 곧 신원이다 (ADR-015 §2). 한 기계에서 노드를 여럿 세우는 것이
# ★ 예외가 아니라 기본 ★ 이다 — 맥에 zephyr 워크스페이스 노드, colima 안의 노드,
# qemu 노드가 각각 선다. 그래서 이 도구는 하나를 다루는 형태를 갖지 않는다.
set -euo pipefail

CONFDIR=${ENODE_CONFDIR:-$HOME/.config/enode}
STATEDIR=${ENODE_STATEDIR:-$HOME/.local/state/enode}
ENODE_BIN=${ENODE_BIN:-$(command -v enode || echo "$HOME/.local/bin/enode")}

mkdir -p "$STATEDIR"

die() { printf '✗ %s\n' "$*" >&2; exit 1; }

# 맥은 shasum, 리눅스(colima VM)는 sha256sum 이다. 둘 다 받는다.
sha256() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256
  else sha256sum; fi
}

conf_of() { printf '%s/%s.yaml\n' "$CONFDIR" "$1"; }
log_of()  { printf '%s/%s.log\n'  "$STATEDIR" "$1"; }

# 살아 있는 pid 를 찍는다. 없으면 빈 문자열.
# ★ 잠금 파일이 곧 상태다 ★ — enode 가 자기 pid 를 거기 쓰고, 죽으면 커널이
# flock 을 푼다. 따로 pid 장부를 두면 그 장부가 진실과 갈라진다.
pid_of() {
  local conf lock pid args
  conf=$(conf_of "$1"); lock="$conf.lock"
  [ -f "$lock" ] || return 0
  pid=$(head -1 "$lock" 2>/dev/null | tr -d '[:space:]')
  case "$pid" in ''|*[!0-9]*) return 0 ;; esac

  # ★ 이름이 아니라 명령줄을 본다 ★
  # pid 는 재사용되고, 실행파일 이름은 배포 방식에 따라 다르다
  # (설치본은 enode, 묶음에서 바로 돌리면 enode-linux-amd64).
  # 우리가 진짜 묻는 것은 ★ 이 설정을 열고 있는 프로세스인가 ★ 다.
  # enode 는 종료해도 잠금 파일을 안 지우므로(flock 은 커널이 푼다)
  # 파일의 존재만으로는 아무것도 못 말한다.
  args=$(ps -p "$pid" -o args= 2>/dev/null) || return 0
  case "$args" in *"$conf"*) printf '%s\n' "$pid" ;; esac
}

# ★ node_id 를 우리가 다시 계산한다 ★
# Derive() 와 같은 식이다: sha256(email ∥ NUL ∥ hostname ∥ NUL ∥ realpath(config))[:12].
# 띄우기 전에 알 수 있어야 `runctl capabilities` 의 어느 줄이 이 맥인지 짚을 수 있다.
node_id() {
  local conf=$1 email host real
  email=$(git config --global --get user.email 2>/dev/null) || true
  [ -n "$email" ] || die "git --global user.email 이 없다"
  host=$(hostname)
  real=$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$conf")
  # ★ NUL 구분자가 핵심이다 ★ — Derive() 가 email\x00host\x00path 를 해싱한다.
  # 파이프는 NUL 을 보존한다 (명령 치환 $( ) 안에 넣으면 잘려나가므로 쓰지 않는다).
  printf '%s\0%s\0%s' "$email" "$host" "$real" | sha256 | cut -c1-12
}

# label 도 같은 규칙이다 — local.yaml 이면 user@host, 아니면 user@host:이름.
node_label() {
  local conf=$1 email host base
  email=$(git config --global --get user.email 2>/dev/null) || true
  host=$(hostname)
  base=$(basename "$conf"); base=${base%.yaml}
  if [ "$base" = "local" ]; then printf '%s@%s\n' "${email%%@*}" "$host"
  else printf '%s@%s:%s\n' "${email%%@*}" "$host" "$base"; fi
}

names() {
  local f
  for f in "$CONFDIR"/*.yaml; do
    [ -e "$f" ] || continue
    local b; b=$(basename "$f"); printf '%s\n' "${b%.yaml}"
  done
}

cmd_list() {
  printf '설정 디렉터리: %s\n\n' "$CONFDIR"
  local n found=0
  while read -r n; do
    [ -n "$n" ] || continue
    found=1
    local pid state
    pid=$(pid_of "$n")
    # ★ ${pid:+A}${pid:-B} 는 A 와 pid 를 ★ 둘 다 ★ 찍는다 ★ (:- 는 「비었을 때만」이
    # 아니라 「비었으면 B, 아니면 pid」다). 실측에서 pid 가 두 번 붙어 나왔다.
    if [ -n "$pid" ]; then state="★ 돈다 pid=$pid"; else state="멈춤"; fi
    printf '  %-14s %-14s %-24s %s\n' \
      "$n" "$(node_id "$(conf_of "$n")")" "$(node_label "$(conf_of "$n")")" "$state"
  done < <(names)
  [ "$found" = 1 ] || printf '  (설정이 없다. %s 에 <이름>.yaml 을 만든다)\n' "$CONFDIR"
}

cmd_id() {
  local n=${1:?이름이 필요하다}; local c; c=$(conf_of "$n")
  [ -f "$c" ] || die "설정이 없다: $c"
  printf 'node_id  %s\nlabel    %s\nconfig   %s\n' \
    "$(node_id "$c")" "$(node_label "$c")" \
    "$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$c")"
}

cmd_start() {
  local n=${1:?이름이 필요하다}; shift || true
  local c; c=$(conf_of "$n")
  [ -f "$c" ] || die "설정이 없다: $c"
  [ -x "$ENODE_BIN" ] || die "enode 실행파일이 없다: $ENODE_BIN"

  local pid; pid=$(pid_of "$n")
  [ -z "$pid" ] || die "이미 돌고 있다 (pid=$pid). enode 의 flock 이 두 번째를 거절한다."

  # ★ 로그인 셸의 PATH 를 그대로 물려준다 ★ — 여기가 맥에서 가장 잘 밟는 자리다.
  # launchd 로 띄우면 PATH 가 최소 집합이라 claude 를 못 찾고, 그러면 harness 가
  # 광고에서 조용히 빠져 계약이 422 를 받는다. 원인이 어디에도 안 보인다.
  command -v claude >/dev/null 2>&1 || \
    printf '▲ PATH 에 claude 가 없다. 이 노드는 harness 를 광고하지 못한다.\n' >&2

  local log; log=$(log_of "$n")
  printf '\n===== %s 기동 =====\n' "$(date '+%Y-%m-%d %H:%M:%S')" >> "$log"
  nohup "$ENODE_BIN" --config "$c" "$@" >> "$log" 2>&1 &
  disown || true

  sleep 1
  pid=$(pid_of "$n")
  if [ -n "$pid" ]; then
    printf '★ 떴다 ★  %s  node=%s  pid=%s\n' "$n" "$(node_id "$c")" "$pid"
    printf '  로그: %s\n' "$log"
  else
    printf '✗ 못 떴다. 로그 끝:\n' >&2
    tail -20 "$log" >&2
    exit 1
  fi
}

cmd_stop() {
  local n=${1:?이름이 필요하다}
  local pid; pid=$(pid_of "$n")
  [ -n "$pid" ] || { printf '이미 멈춰 있다: %s\n' "$n"; return 0; }
  # SIGTERM 이면 signal.NotifyContext 가 받아 ★ 스스로 정리하고 끝난다 ★.
  kill -TERM "$pid"
  for _ in $(seq 1 20); do
    [ -n "$(pid_of "$n")" ] || { printf '멈췄다: %s\n' "$n"; return 0; }
    sleep 0.5
  done
  printf '▲ 20초 안에 안 끝났다. 강제로 죽인다 (pid=%s)\n' "$pid" >&2
  kill -KILL "$pid"
}

cmd_logs() {
  local n=${1:?이름이 필요하다}; shift || true
  local log; log=$(log_of "$n")
  [ -f "$log" ] || die "로그가 없다: $log"
  if [ "${1:-}" = "-f" ]; then tail -f "$log"; else tail -50 "$log"; fi
}

cmd_status() {
  cmd_list
  printf '\n'
  local n
  while read -r n; do
    [ -n "$n" ] || continue
    local pid; pid=$(pid_of "$n")
    [ -n "$pid" ] || continue
    printf '── %s ── 최근 로그\n' "$n"
    tail -5 "$(log_of "$n")" | sed 's/^/   /'
    printf '\n'
  done < <(names)
}

case "${1:-status}" in
  list)   shift; cmd_list ;;
  id)     shift; cmd_id "$@" ;;
  start)  shift; cmd_start "$@" ;;
  stop)   shift; cmd_stop "$@" ;;
  logs)   shift; cmd_logs "$@" ;;
  status) shift || true; cmd_status ;;
  -h|--help|help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "모르는 명령: $1  (list · id · start · stop · logs · status)" ;;
esac
