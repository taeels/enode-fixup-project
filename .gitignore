# Go
/bin/
*.exe
*.test
*.out

# 저장소 뿌리에 굽는 산출물. 한 번 커밋되어 CI 를 다섯 판 붉게 만들었다 —
# 컴파일된 바이너리 안에서 E2 98 85 세 바이트가 우연히 이어지면 장식 문자
# 검사가 그것을 잡고, 사람은 어느 소스에 별이 들어왔는지 찾다가 못 찾는다.
/enode
/enodectl
/mediator
/runctl

# 로컬 설정 (신원이 되는 파일 — ADR-015 §2)
/local/

# 배포 묶음 (packaging/macos/build.sh 의 산출물)
/dist/

# 로컬 실행이 남기는 로그
