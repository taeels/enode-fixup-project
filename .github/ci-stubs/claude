#!/bin/sh
# 가짜 claude — CI 에서 하네스 부재로 조용히 스킵되던 두 테스트를 살리는 스텁.
#
# 무엇을 여는가
#
#   internal/enode/claude_test.go:106  TestAdapter_ProbeIsResolve
#   internal/enode/enode_test.go:145   TestDetect_OrchestrationAdvertisesExclusively
#
# 둘 다 claude 가 PATH 에 없으면 t.Skip 으로 사라진다. 후자가 단언하는 것은
# "오케스트레이션 노드는 arch 를 광고하면 안 된다"(ADR-022 §5)이고, 광고하면
# 명령 단계가 Mediator 기계에서 돌아 DB·아티팩트·토큰에 무경계 argv 가 닿는다.
# 그 단언이 CI 에서 한 번도 실행된 적이 없다.
#
# 왜 커버리지로는 이 구멍이 안 보이는가 — 실측이다. 하네스가 없는 쪽이
# internal/enode 67.7%, 있는 쪽이 67.5% 로 스킵하는 구성이 오히려 더 높다.
# 커버리지만 보는 게이트는 스킵하는 구성을 선호한다. 잃는 것은 0.2 포인트가
# 아니라 단언 자체다.
#
# 어떤 호출을 받는가 — internal/enode/claude.go 의 두 자리뿐이다.
#
#   claudeUsable()  claude auth status --json   stdout 의 loggedIn 만 읽는다.
#                                               종료코드는 안 본다(ADR-059).
#   Probe()         claude --version            빈 문자열이 아니어야 한다.
#
# Detect() 는 Probe 가 성공해야 attrs["harness"] 를 싣고, 오케스트레이션
# 노드에서는 arch 가 지워지므로 harness 가 caps 를 비지 않게 하는 유일한
# 값이다. 즉 이 스텁이 없으면 위 두 번째 테스트는 단언에 닿지 못한다.
#
# 무엇을 일부러 안 하는가 — 환경변수를 하나도 읽지 않는다. 진짜 하네스에게
# ENODE_* 와 DATABASE_URL 을 넘기지 않는 것이 I1("열쇠가 하나")의 근거
# 장치이고(protocol/INVARIANTS.md:257, internal/enode/env.go 의 harnessEnv 가
# 걸러내기가 아니라 허용목록 쌓기로 그것을 구조로 강제한다), 가짜라고 해서
# 그 경계를 넘어다보면 스텁이 그 불변식을 시험에서 지우는 자리가 된다.
# 이 스크립트에 $ENODE_ 나 $DATABASE_URL 이 한 번도 안 나오는 것은 실수가
# 아니라 이 이유다.
#
# 선례 — internal/enode/claude_test.go 의 TestAdapter_TheVersionRidesTheResult
# 이 임시 디렉터리에 같은 모양의 셸 스텁을 만든다. 이것은 그 형태를 CI 가
# 쓸 수 있게 파일로 고정한 것이다.

set -u

case "${1:-}" in
--version)
	# Probe 가 TrimSpace 해서 그대로 쓴다. 진짜 버전과 헷갈리지 않게
	# fake 를 문자열에 남긴다 — 이 값이 Record 에 실려 나가므로,
	# 봉인된 기록만 보고 "이건 CI 스텁이 돌린 것"을 알 수 있어야 한다.
	echo '0.0.0-ci-stub (fake)'
	exit 0
	;;
auth)
	# claudeUsable 은 stdout 의 loggedIn 만 읽고 종료코드는 안 본다.
	# 형식을 모르면 "쓸 수 있다"로 떨어지지만, 그 관대한 경로에 기대지
	# 않고 명시적으로 참을 답한다 — 스텁이 열어 주는 것이 우연이 아니라
	# 결정이어야 이 파일을 읽는 사람이 무엇을 가정했는지 안다.
	echo '{"loggedIn":true}'
	exit 0
	;;
esac

# 그 밖의 호출은 실제 작업 요청이다. 지금 CI 가 여는 두 테스트는 여기까지
# 오지 않지만(Probe 와 Detect 에서 끝난다), 조용히 아무것도 안 하고 성공하는
# 것은 이 파일이 막으려는 바로 그 실패 양식이라 결과 봉투를 찍는다.
# claudeHarness.Decode 가 읽는 최소 형태이고, 하네스 경로를 더 덮는 테스트가
# 생기면 이 스텁이 함께 자라야 한다.
printf '{"type":"result","subtype":"success","num_turns":1}\n'
